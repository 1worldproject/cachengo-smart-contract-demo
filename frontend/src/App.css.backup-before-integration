* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
    'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}

.app {
  min-height: 100vh;
  width: 100%;
  position: relative;
  overflow: hidden;
}

.landing-screen {
  min-height: 100vh;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  background: 
    radial-gradient(circle at 20% 50%, rgba(99, 102, 241, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 80%, rgba(236, 72, 153, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 40% 20%, rgba(59, 130, 246, 0.1) 0%, transparent 50%),
    linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
}

.hero-content {
  text-align: center;
  z-index: 10;
  max-width: 900px;
  padding: 0 20px;
  width: 100%;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  padding: 8px 20px;
  border-radius: 30px;
  color: white;
  font-size: 0.9em;
  font-weight: 500;
  margin-bottom: 30px;
}

.hero-title {
  font-size: 4.5em;
  font-weight: 800;
  color: white;
  line-height: 1.1;
  margin-bottom: 25px;
  letter-spacing: -0.02em;
}

.gradient-text {
  display: block;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-subtitle {
  font-size: 1.3em;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 40px;
  line-height: 1.6;
}

.cta-button {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  padding: 18px 40px;
  font-size: 1.1em;
  font-weight: 600;
  border-radius: 16px;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 10px 40px rgba(102, 126, 234, 0.4);
}

.cta-button:hover {
  box-shadow: 0 15px 50px rgba(102, 126, 234, 0.6);
  transform: translateY(-2px);
}

.hero-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40px;
  margin-top: 60px;
  padding: 30px;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.stat {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.stat-value {
  font-size: 2em;
  font-weight: 700;
  color: white;
}

.stat-label {
  font-size: 0.9em;
  color: rgba(255, 255, 255, 0.6);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.stat-divider {
  width: 1px;
  height: 40px;
  background: rgba(255, 255, 255, 0.2);
}

.hero-decoration {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.floating-card {
  position: absolute;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.card-1 {
  width: 300px;
  height: 200px;
  top: 10%;
  left: 5%;
  animation: float 6s ease-in-out infinite;
}

.card-2 {
  width: 250px;
  height: 180px;
  bottom: 15%;
  right: 8%;
  animation: float 8s ease-in-out infinite;
  animation-delay: -2s;
}

.card-3 {
  width: 200px;
  height: 150px;
  top: 60%;
  left: 10%;
  animation: float 7s ease-in-out infinite;
  animation-delay: -4s;
}

@keyframes float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-20px) rotate(1deg); }
}

.template-screen {
  min-height: 100vh;
  width: 100%;
  padding: 80px 40px;
  background: linear-gradient(135deg, #1e1e2e 0%, #2d2d44 100%);
}

.template-header {
  text-align: center;
  margin-bottom: 60px;
}

.template-header h2 {
  font-size: 3em;
  font-weight: 700;
  color: white;
  margin-bottom: 15px;
}

.template-header p {
  font-size: 1.2em;
  color: rgba(255, 255, 255, 0.6);
}

.template-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 30px;
  max-width: 1400px;
  margin: 0 auto;
}

.template-card {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;
  padding: 40px;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.template-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: var(--accent-color);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.template-card:hover::before {
  opacity: 1;
}

.template-card:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: var(--accent-color);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
}

.template-icon {
  width: 80px;
  height: 80px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  margin-bottom: 25px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

.template-card h3 {
  font-size: 1.5em;
  font-weight: 600;
  color: white;
  margin-bottom: 12px;
}

.template-card p {
  font-size: 1em;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
  margin-bottom: 20px;
}

.template-arrow {
  font-size: 1.5em;
  color: var(--accent-color);
  opacity: 0;
  transition: all 0.3s ease;
}

.template-card:hover .template-arrow {
  opacity: 1;
  transform: translateX(5px);
}

.form-screen {
  min-height: 100vh;
  width: 100%;
  padding: 40px;
  background: linear-gradient(135deg, #1e1e2e 0%, #2d2d44 100%);
}

.form-header {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 40px;
  max-width: 1200px;
  margin-left: auto;
  margin-right: auto;
}

.back-button {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: white;
  padding: 12px 24px;
  border-radius: 12px;
  cursor: pointer;
  font-size: 1em;
  transition: all 0.3s ease;
}

.back-button:hover {
  background: rgba(255, 255, 255, 0.15);
}

.form-header h2 {
  font-size: 2em;
  color: white;
  font-weight: 600;
}

.form-content {
  max-width: 1200px;
  margin: 0 auto;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;
  padding: 60px;
  color: white;
}

.template-form {
  max-width: 100%;
}

.form-section {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16px;
  padding: 30px;
  margin-bottom: 24px;
}

.form-section h3 {
  font-size: 1.3em;
  color: white;
  margin-bottom: 20px;
  font-weight: 600;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-field.full-width {
  grid-column: 1 / -1;
}

.form-field label {
  color: rgba(255, 255, 255, 0.9);
  font-size: 0.9em;
  font-weight: 500;
}

.form-field input,
.form-field select,
.form-field textarea {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  padding: 14px 16px;
  color: white;
  font-size: 1em;
  font-family: inherit;
  transition: all 0.3s ease;
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
  outline: none;
  border-color: rgba(102, 126, 234, 0.8);
  background: rgba(255, 255, 255, 0.08);
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.form-field input::placeholder,
.form-field textarea::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.form-field textarea {
  resize: vertical;
  min-height: 100px;
}

.form-actions {
  display: flex;
  gap: 16px;
  justify-content: flex-end;
  margin-top: 32px;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  padding: 16px 32px;
  font-size: 1em;
  font-weight: 600;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: rgba(255, 255, 255, 0.1);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.2);
  padding: 16px 32px;
  font-size: 1em;
  font-weight: 600;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-secondary:hover {
  background: rgba(255, 255, 255, 0.15);
}

.wallet-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(102, 126, 234, 0.2);
  border: 1px solid rgba(102, 126, 234, 0.3);
  padding: 10px 20px;
  border-radius: 12px;
  color: white;
  font-size: 0.9em;
  font-weight: 500;
  margin-left: auto;
}

.deploying-screen {
  min-height: 100vh;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1e1e2e 0%, #2d2d44 100%);
}

.deploying-content {
  text-align: center;
  max-width: 600px;
  padding: 60px 40px;
}

.spinner-container {
  margin-bottom: 32px;
}

.spinner {
  width: 80px;
  height: 80px;
  border: 4px solid rgba(102, 126, 234, 0.2);
  border-top-color: #667eea;
  border-radius: 50%;
  margin: 0 auto;
}

.deploying-content h2 {
  font-size: 2.5em;
  color: white;
  margin-bottom: 12px;
}

.deploying-content p {
  color: rgba(255, 255, 255, 0.6);
  font-size: 1.1em;
  margin-bottom: 48px;
}

.deployment-steps {
  display: flex;
  flex-direction: column;
  gap: 16px;
  text-align: left;
}

.step {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 24px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  color: rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
}

.step.active {
  color: white;
  background: rgba(102, 126, 234, 0.1);
  border-color: rgba(102, 126, 234, 0.3);
}

.step svg {
  flex-shrink: 0;
  color: #10b981;
}

.step-loader {
  width: 20px;
  height: 20px;
  border: 2px solid rgba(102, 126, 234, 0.3);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  flex-shrink: 0;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.success-screen {
  min-height: 100vh;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1e1e2e 0%, #2d2d44 100%);
  padding: 40px 20px;
}

.success-content {
  max-width: 800px;
  width: 100%;
  text-align: center;
}

.success-icon {
  color: #10b981;
  margin-bottom: 24px;
}

.success-content h1 {
  font-size: 2.5em;
  color: white;
  margin-bottom: 12px;
}

.success-subtitle {
  font-size: 1.2em;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 48px;
}

.deployment-info {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 40px;
}

.info-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16px;
  padding: 20px 24px;
  text-align: left;
}

.info-card label {
  display: block;
  color: rgba(255, 255, 255, 0.6);
  font-size: 0.85em;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 8px;
}

.info-value {
  display: flex;
  align-items: center;
  gap: 12px;
  color: white;
  font-family: 'Monaco', 'Menlo', monospace;
  font-size: 0.9em;
  word-break: break-all;
}

.external-link {
  flex-shrink: 0;
  color: #667eea;
  transition: color 0.3s ease;
}

.external-link:hover {
  color: #764ba2;
}

.success-actions {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
}

/* Enhanced Mobile Responsiveness */
@media (max-width: 1024px) {
  .template-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
}

@media (max-width: 768px) {
  .app {
    padding: 0;
  }

  .hero-title {
    font-size: 2.8em;
  }
  
  .hero-subtitle {
    font-size: 1.1em;
  }
  
  .template-screen {
    padding: 40px 20px;
  }

  .template-grid {
    grid-template-columns: 1fr;
    gap: 16px;
    padding: 0;
  }
  
  .template-card {
    padding: 24px;
  }
  
  .template-header h2 {
    font-size: 2em;
  }
  
  .form-screen {
    padding: 20px;
  }

  .form-content {
    padding: 30px 20px;
  }

  .form-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  
  .form-section {
    padding: 20px;
  }
  
  .form-actions {
    flex-direction: column;
    gap: 12px;
  }

  .btn-primary,
  .btn-secondary {
    width: 100%;
    justify-content: center;
  }

  .template-header {
    flex-direction: column;
    gap: 16px;
    text-align: center;
  }

  .wallet-badge {
    margin-left: 0;
  }

  .form-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .form-header .wallet-badge {
    align-self: center;
  }

  .success-actions {
    flex-direction: column;
    gap: 12px;
  }

  .success-actions button {
    width: 100%;
  }

  .info-card {
    padding: 16px 20px;
  }

  .info-value {
    font-size: 0.85em;
  }

  .hero-stats {
    flex-direction: column;
    gap: 20px;
    padding: 20px;
  }

  .stat-divider {
    width: 100px;
    height: 1px;
  }

  .deploying-content {
    padding: 40px 20px;
  }

  .success-content {
    padding: 20px;
  }

  .success-content h1 {
    font-size: 2em;
  }

  .success-subtitle {
    font-size: 1em;
  }

  .card-1, .card-2, .card-3 {
    display: none;
  }
}

@media (max-width: 480px) {
  .hero-title {
    font-size: 2.2em;
  }

  .hero-subtitle {
    font-size: 1em;
  }

  .cta-button {
    padding: 14px 28px;
    font-size: 1em;
  }

  .template-header h2 {
    font-size: 1.6em;
  }

  .template-header p {
    font-size: 1em;
  }

  .template-card h3 {
    font-size: 1.3em;
  }

  .form-section h3 {
    font-size: 1.2em;
  }

  .form-field label {
    font-size: 0.85em;
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    padding: 12px 14px;
    font-size: 0.95em;
  }

  .success-content h1 {
    font-size: 1.6em;
  }

  .success-icon svg {
    width: 60px;
    height: 60px;
  }

  .deploying-content h2 {
    font-size: 1.8em;
  }

  .stat-value {
    font-size: 1.5em;
  }

  .stat-label {
    font-size: 0.8em;
  }
}

/* Landscape mobile optimization */
@media (max-width: 896px) and (orientation: landscape) {
  .landing-screen {
    min-height: auto;
    padding: 40px 20px;
  }

  .hero-content {
    padding: 20px 0;
  }

  .hero-title {
    font-size: 2.5em;
    margin-bottom: 15px;
  }

  .hero-subtitle {
    margin-bottom: 25px;
  }

  .hero-stats {
    margin-top: 30px;
    flex-direction: row;
    gap: 20px;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
  }
}

/* Tablet optimization */
@media (min-width: 768px) and (max-width: 1024px) {
  .template-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .form-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .form-field.full-width {
    grid-column: 1 / -1;
  }
}

/* Fix for very small screens */
@media (max-width: 360px) {
  .app {
    padding: 0;
  }

  .hero-title {
    font-size: 1.8em;
  }

  .template-card {
    padding: 20px;
  }

  .form-section {
    padding: 16px;
  }

  .btn-primary,
  .btn-secondary {
    padding: 12px 20px;
    font-size: 0.9em;
  }
}

::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.05);
}

::-webkit-scrollbar-thumb {
  background: rgba(102, 126, 234, 0.5);
  border-radius: 5px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(102, 126, 234, 0.7);
}
